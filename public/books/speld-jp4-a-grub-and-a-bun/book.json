{
 "id": "speld-jp4-a-grub-and-a-bun",
 "title": "A grub and a bun",
 "author": "SPELD SA (Jolly Phonics Set 4)",
 "pages": [
  {
   "text": "Jim",
   "image": "00.jpg",
   "w": 700,
   "h": 993
  },
  {
   "text": "Jim has a bun.\nIt has red jam in it.",
   "image": "01.jpg",
   "w": 700,
   "h": 993
  },
  {
   "text": "He bit into the bun.",
   "image": "02.jpg",
   "w": 700,
   "h": 993
  },
  {
   "text": "He cannot see red\njam. He can see green!",
   "image": "03.jpg",
   "w": 700,
   "h": 993
  },
  {
   "text": "It is a green grub.\nA grub is in the bun.",
   "image": "04.jpg",
   "w": 700,
   "h": 993
  },
  {
   "text": "Jim spits in the drain\nbut the grub is in him.",
   "image": "05.jpg",
   "w": 700,
   "h": 993
  },
  {
   "text": "He has a drink but\nfeels ill.",
   "image": "06.jpg",
   "w": 700,
   "h": 993
  },
  {
   "text": "No jam bun for him\nagain. Jim has a pie!",
   "image": "07.jpg",
   "w": 700,
   "h": 993
  }
 ]
}