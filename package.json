{
  "name": "reading-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node tests/smoke.mjs",
    "validate": "tsx scripts/validate-content.ts && tsx scripts/validate-math.ts",
    "validate:math": "tsx scripts/validate-math.ts",
    "audio": "tsx scripts/gen-audio.ts",
    "mine": "tsx scripts/mine-books.ts",
    "local": "vite build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "books": "tsx scripts/books/build.ts",
    "sounds": "tsx scripts/import-sounds.ts",
    "pictures": "tsx scripts/pictures/generate.ts"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jszip": "^3.10.2",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "~5.6.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  }
}
